{
  "name": "gen-p12",
  "version": "1.0.1",
  "main": "main.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "start": "webpack serve --config webpack.config.js --mode development",
    "screenshots": "node scripts/screenshots.mjs",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run check:docs-cover && node --test",
    "release:check": "npm test && npm run build",
    "preversion": "bash scripts/preversion.sh",
    "postversion": "git push --atomic origin main v$npm_package_version"
  },
  "keywords": [],
  "author": "james.klein@salesforce.com",
  "license": "Apache-2.0",
  "description": "A static website which generates p12 files in the browser for code upload to Salesforce B2C Commerce Staging instances.",
  "devDependencies": {
    "playwright": "^1.61.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0"
  }
}
