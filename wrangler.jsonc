{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "p12-generator",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "p12.sfcc-test.com",
      "custom_domain": true
    },
    {
      "pattern": "p12.fad.bz",
      "custom_domain": true
    }
  ]
}
